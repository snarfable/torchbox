{
	"name": "PyTorch + OpenCV",
	"build": {
		"context": "..",
		"dockerfile": "Dockerfile"
	},
	// Uncomment to enable NVIDIA GPU access (requires nvidia-container-toolkit on the host).
	// "runArgs": ["--gpus", "all"],
	"runArgs": [
		"--device=/dev/video0",
		"--device=/dev/video1",
		"--device=/dev/video2",
		"--device=/dev/video3",
		"--net=host",                                  // Required to easily link to local sockets
		"--ipc=host",                                  // Required for Shared Memory extensions (MIT-SHM)
		"--device=/dev/dri:/dev/dri"                  // For GPU hardware acceleration
	],
	"containerEnv": {
		"DISPLAY": "${localEnv:DISPLAY}",
		"XAUTHORITY": "/tmp/.Xauthority",
		"WAYLAND_DISPLAY": "${localEnv:WAYLAND_DISPLAY}",
		"XDG_RUNTIME_DIR": "${localEnv:XDG_RUNTIME_DIR}"
	},
	"mounts": [
		"source=/tmp/.X11-unix,target=/tmp/.X11-unix,type=bind",
		"source=${localEnv:HOME}/.Xauthority,target=/tmp/.Xauthority,type=bind,readonly",
		"source=${localEnv:XDG_RUNTIME_DIR}/${localEnv:WAYLAND_DISPLAY},target=${localEnv:XDG_RUNTIME_DIR}/${localEnv:WAYLAND_DISPLAY},type=bind,consistency=cached"
	],
	"features": {
		"ghcr.io/devcontainers/features/git:1": {}
	},
	"customizations": {
		"vscode": {
			"extensions": [
				"ms-python.python",
				"ms-python.vscode-pylance",
				"ms-toolsai.jupyter",
				"charliermarsh.ruff"
			],
			"settings": {
				"python.defaultInterpreterPath": "/usr/local/bin/python",
				"python.testing.pytestEnabled": true
			}
		}
	},
	"postCreateCommand": "pip install --no-cache-dir -r .devcontainer/requirements.txt",
	"remoteUser": "vscode"
}
